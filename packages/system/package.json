{
  "name": "@react-native-mcp/system",
  "version": "0.1.0",
  "description": "System information, brightness and phone tools for React Native MCP.",
  "license": "MIT",
  "author": "Hector Zhuang <i@hector.im> (https://github.com/Hector-Zhuang)",
  "homepage": "https://github.com/Hector-Zhuang/react-native-mcp/tree/main/packages/system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hector-Zhuang/react-native-mcp.git",
    "directory": "packages/system"
  },
  "bugs": {
    "url": "https://github.com/Hector-Zhuang/react-native-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "react-native",
    "system-info",
    "device-info"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "bob build",
    "prepack": "bob build",
    "clean": "del-cli lib",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-native-mcp/core": "0.1.0",
    "react": "*",
    "react-native": "*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "del-cli": "^7.0.0",
    "react-native-builder-bob": "^0.43.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@bam.tech/react-native-image-resizer": "^3.0.11",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-community/netinfo": "^12.0.1",
    "react-native-device-info": "^15.0.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-system-setting": "^1.7.6"
  }
}
